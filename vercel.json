{
    "functions": {
        "api/**/*.js": {
            "includeFiles": "company information.docx"
        }
    },
    "rewrites": [
        {
            "source": "/chatbot/message",
            "destination": "/api/chatbot/message"
        },
        {
            "source": "/contact/message",
            "destination": "/api/contact/message"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "client/dist"
}
